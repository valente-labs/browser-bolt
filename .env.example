# Copy to .env in the checkout. Keep real keys out of source control.
TYPESAFE_PROVIDER=openrouter
OPENROUTER_API_KEY=
TYPESAFE_MODEL=typesafe/jev-1.13
CEREBRAS_API_KEY=
TEXT_MODEL_BASE_URL=https://api.cerebras.ai/v1
TEXT_MODEL=qwen-3.8-27b
TEXT_MODEL_REASONING=none

# hybrid: Jev with one Qwen fallback; jev: no decision fallback; qwen: Qwen only.
QWEV_POLICY=hybrid
# Experimental routing cutoff, not a measured success probability. Range: 0 to 1.
QWEV_CONFIDENCE_THRESHOLD=0.6
# Decision model, independent of TEXT_MODEL used by the Jev field-writing helper.
QWEV_CEREBRAS_MODEL=qwen-3.8-27b
